{
  "reasons": {
    "whitespace": "Comment text keeps its leading and trailing spaces exactly as transmitted; FAP trims them.",
    "case": "Callsigns keep the case transmitted; FAP uppercases them.",
    "course_zero": "A compressed course byte of 0 is reported as 0 degrees, as transmitted; FAP rewrites it to 360.",
    "mic_e_sequence": "Mic-E hex telemetry carries no sequence number, so none is reported; FAP reports 0.",
    "nmea_precision": "NMEA course keeps the transmitted precision; FAP rounds to whole degrees.",
    "nmea_symbol": "APRS101 assigns a default symbol from the source SSID when NMEA has no symbol destination (SSID 11 is the balloon, /O); FAP reports no symbol.",
    "parm_case": "APRS101 defines the telemetry keywords in upper case, so 'parm.' is ordinary message text; FAP matches them case-insensitively.",
    "wx_symbol": "A weather-station symbol with no weather fields is a position with a comment; FAP reports an empty weather report and discards the comment.",
    "disputed_wind": "The uncompressed wind-speed unit is disputed between the specifications and stays marked as disputed; FAP assumes mph.",
    "user_defined": "'{' is APRS101's user-defined data type, so this decodes as user-defined data; FAP rejects experimental formats.",
    "unknown_nmea": "Unknown NMEA sentences are kept as opaque data with an 'unsupported' diagnostic, not rejected.",
    "vtg": "$GPVTG is a supported NMEA sentence (course and speed only, so no usable position); FAP rejects it.",
    "beacon": "Text with no position in the first 40 bytes is a non-APRS beacon, kept as text; FAP rejects it.",
    "mic_e_type_suffix": "APRS 1.2 Mic-E type codes end the status text with a declared version suffix (\"=\" after \"]\" is the TM-D710); it is part of device_code, not comment text.",
    "mic_e_type_byte": "APRS 1.2 redefines a leading ` or ' as a Mic-E type byte; APRS101 hex telemetry needs the complete form (10 hex digits after '), so this is a type code followed by comment text. FAP reads two channels.",
    "mic_e_manufacturer": "APRS 1.2 Mic-E type code ' with the Byonics TinyTrack3 suffix |3 is stored in device_code; FAP keeps both in the comment.",
    "mic_e_corrupt": "A byte was lost in transit, so the symbol table is invalid; FAP's accept_broken_mice option guesses the repair, while the public parser reports the packet as Malformed.",
    "timestamp_day_zero": "Day 00 is not a valid timestamp, so the packet is Malformed and Malformed.recovered keeps the other fields; FAP decodes them with a warning. TIM-011 allows either.",
    "gll_minimal": "This GLL sentence has no time or fix status, which the GLL model requires and the parser does not invent, so it is Malformed; FAP accepts the coordinates alone.",
    "telemetry_short": "A short telemetry report decodes with only the channels transmitted and is marked nonconforming; FAP pads it to five channels.",
    "telemetry_invalid": "A non-numeric telemetry channel cannot be decoded, so the report is Malformed; FAP keeps the channels before it.",
    "telemetry_comment": "Text after the telemetry digital bits is kept as the comment; FAP discards it.",
    "weather_unknown_field": "'O' is not a weather field in APRS101, the APRS 1.1 clarification or the APRS 1.2 proposal, so the report ends there and the rest stays in the comment; FAP skips it.",
    "compressed_dao": "DAO precision describes refinements of DDMM.hh/DDDMM.hh fields, not compressed coordinates. Preserve the DAO evidence and baseline compressed coordinates with a diagnostic; do not apply an invented correction.",
    "nmea_no_fix": "A void or invalid NMEA fix is a valid sentence that is not a position fix (position_usable=false); FAP rejects it."
  },
