{
  "reasons": {
    "whitespace": "Comment text keeps its leading and trailing spaces exactly as transmitted; FAP trims them.",
    "case": "Callsigns keep the case transmitted; FAP uppercases them.",
    "course_zero": "A compressed course byte of 0 is reported as 0 degrees, as transmitted; FAP rewrites it to 360.",
    "mic_e_sequence": "Mic-E hex telemetry carries no sequence number, so none is reported; FAP reports 0.",
    "nmea_precision": "NMEA course keeps the transmitted precision; FAP rounds to whole degrees.",
    "nmea_symbol": "APRS101 assigns a default symbol from the source SSID when NMEA has no symbol destination (SSID 11 is the balloon, /O); FAP reports no symbol.",
    "parm_case": "APRS101 defines the telemetry keywords in upper case, so 'parm.' is ordinary message text; FAP matches them case-insensitively.",
    "wx_symbol": "A weather-station symbol with no weather fields is a position with a comment; FAP reports an empty weather report and discards the comment.",
    "disputed_wind": "The uncompressed wind-speed unit is disputed between the specifications and stays marked as disputed; FAP assumes mph.",
    "user_defined": "'{' is APRS101's user-defined data type, so this decodes as user-defined data; FAP rejects experimental formats.",
    "unknown_nmea": "Unknown NMEA sentences are kept as opaque data with an 'unsupported' diagnostic, not rejected.",
    "vtg": "$GPVTG is a supported NMEA sentence (course and speed only, so no usable position); FAP rejects it.",
    "beacon": "Text with no position in the first 40 bytes is a non-APRS beacon, kept as text; FAP rejects it."
  },
